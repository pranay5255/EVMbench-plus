    {"report_id": "M-1", "pages": [24, 25], "reported_severity": "Medium", "reported_status": "Resolved", "disposition": "included", "finding_id": "H-03", "asset_loss_path": "The final holder or liquidator irrecoverably loses LP fees left in the wrapper after full unwrap."},
