())) >= amount, \"Insufficient Balance\");\n    assert(!token.allowance(get_caller_address(), get_contract_address())) >= amount, \"Not Enough Allowence\"\n    );\n    token.transfer_from(get_caller_address(), get_contract_address(), amount);\n<|det|>page_number [910, 955, 937, 970]<|/det|>15\n", "page_image_sha256": "ffa38d649f3471e1dff3a63ff73f7c9799d7bece2f97aea24b5068ee4d3094b1", "page_number": 15, "pdf_id": "pdf_002905_2a0554b0cbcc", "raw_response_ref": "chunk_0020/other_audit_repo_pdfs/pdf_002905_2a0554b0cbcc_train_protocol-feb-25_Public__upd/pages_0013_0016.raw.json", "source_abs_path": "/home/experiments_base/smart-contract-data/crawlers/output/repos/audit_repos/Smart-Contract-Review-Public-Reports/train_protocol-feb-25(Public)_upd.pdf", "source_bucket": "other_audit_repo_pdfs", "source_filename": "train_protocol-feb-25(Public)_upd.pdf", "source_page_count": 30, "source_pdf_sha256": "e064e1c503ded4c074c2b8cde2095ecebcd5f68fe17ea0cfa9b101cc8d2dbe71", "source_rel_path": "Smart-Contract-Review-Public-Reports/train_protocol-feb-25(Public)_upd.pdf", "tables": [], "throughput": {"output_units": "tokens", "output_units_per_second": 513.033}, "timing_ms": {"decode": 844, "sglang_total": 1012, "ttft": 168}, "usage": {"completion_token_source": "openai_usage", "completion_tokens": 433, "prompt_tokens": 278, "prompt_tokens_details": null, "reasoning_tokens": 0, "total_tokens": 711}, "warnings": []}, "raw_response_ref": "chunk_0020/other_audit_repo_pdfs/pdf_002905_2a0554b0cbcc_train_protocol-feb-25_Public__upd/pages_0013_0016.raw.json", "schema_version": "evmbench_task_creation.ocr_page.v1", "source_bucket": "other_audit_repo_pdfs", "source_filename": "train_protocol-feb-25(Public)_upd.pdf", "source_page_count": 30, "source_pdf_sha256": "e064e1c503ded4c074c2b8cde2095ecebcd5f68fe17ea0cfa9b101cc8d2dbe71", "source_rel_path": "Smart-Contract-Review-Public-Reports/train_protocol-feb-25(Public)_upd.pdf", "text_length": 1713}
