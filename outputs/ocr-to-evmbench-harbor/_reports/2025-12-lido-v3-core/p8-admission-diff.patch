+{"created_at": "2026-06-29T21:15:28.640711+00:00", "ocr_backend": "sglang", "ocr_endpoint_version": "modal-sglang-unlimited-ocr-v1", "ocr_model": "Unlimited-OCR", "ocr_model_version": "Unlimited-OCR", "ocr_text": "<PAGE><|det|>text [81, 60, 264, 72]<|/det|>more than necessary.\n<|det|>title [81, 95, 232, 108]<|/det|>Client's Commentary:\n<|det|>text [80, 111, 897, 175]<|/det|>As bad debt internalization is perceived as emergency measure that will be used semi-manually and preceded by the Lido DAO governance decision and only after the other means to compensate the bad debt will be exhausted, we think that this imperfection in design is acceptable. Especially, noticing the fact that the possible impact in realistic scenarios is very low and also requires that the vault still hold some value (which is unlikely, because it should have been rebalanced before).\n<|det|>footer [82, 950, 248, 972]<|/det|>MixBytes()\n<|det|>page_number [880, 952, 916, 970]<|/det|>16\n", "page_image_sha256": "01b2171515d73868b879148bb9e560ad76560b40157ed16e45ff46fabd1f5ef5", "page_number": 17, "pdf_id": "pdf_003436_1e68fc3994b5", "raw_record": {"code_blocks": [], "confidence": null, "created_at": "2026-06-29T21:15:28.640711+00:00", "layout_blocks": [], "ocr_backend": "sglang", "ocr_endpoint_version": "modal-sglang-unlimited-ocr-v1", "ocr_model": "Unlimited-OCR", "ocr_model_version": "Unlimited-OCR", "ocr_settings": {"dpi": 300, "image_mode": "base", "mode": "pages", "ngram_size": 35, "ngram_window": 1024, "prompt": "Multi page parsing."}, "ocr_text": "<PAGE><|det|>text [81, 60, 264, 72]<|/det|>more than necessary.\n<|det|>title [81, 95, 232, 108]<|/det|>Client's Commentary:\n<|det|>text [80, 111, 897, 175]<|/det|>As bad debt internalization is perceived as emergency measure that will be used semi-manually and preceded by the Lido DAO governance decision and only after the other means to compensate the bad debt will be exhausted, we think that this imperfection in design is acceptable. Especially, noticing the fact that the possible impact in realistic scenarios is very low and also requires that the vault still hold some value (which is unlikely, because it should have been rebalanced before).\n<|det|>footer [82, 950, 248, 972]<|/det|>MixBytes()\n<|det|>page_number [880, 952, 916, 970]<|/det|>16\n", "page_image_sha256": "01b2171515d73868b879148bb9e560ad76560b40157ed16e45ff46fabd1f5ef5", "page_number": 17, "pdf_id": "pdf_003436_1e68fc3994b5", "raw_response_ref": "chunk_0007/other_audit_repo_pdfs/pdf_003436_1e68fc3994b5_Lido_v3_Security_Audit_Report/pages_0017_0020.raw.json", "source_abs_path": "/home/experiments_base/smart-contract-data/crawlers/output/repos/audit_repos/audits_public/Lido/Lido v3/Lido v3 Security Audit Report.pdf", "source_bucket": "other_audit_repo_pdfs", "source_filename": "Lido v3 Security Audit Report.pdf", "source_page_count": 35, "source_pdf_sha256": "394412f5537fe8936dad4362cad9a71bf8d37c4bf7e759bdd2d021e4f98cbcda", "source_rel_path": "audits_public/Lido/Lido v3/Lido v3 Security Audit Report.pdf", "tables": [], "throughput": {"output_units": "tokens", "output_units_per_second": 475.578}, "timing_ms": {"decode": 389, "sglang_total": 578, "ttft": 188}, "usage": {"completion_token_source": "openai_usage", "completion_tokens": 185, "prompt_tokens": 278, "prompt_tokens_details": null, "reasoning_tokens": 0, "total_tokens": 463}, "warnings": []}, "raw_response_ref": "chunk_0007/other_audit_repo_pdfs/pdf_003436_1e68fc3994b5_Lido_v3_Security_Audit_Report/pages_0017_0020.raw.json", "schema_version": "evmbench_task_creation.ocr_page.v1", "source_bucket": "other_audit_repo_pdfs", "source_filename": "Lido v3 Security Audit Report.pdf", "source_page_count": 35, "source_pdf_sha256": "394412f5537fe8936dad4362cad9a71bf8d37c4bf7e759bdd2d021e4f98cbcda", "source_rel_path": "audits_public/Lido/Lido v3/Lido v3 Security Audit Report.pdf", "text_length": 755}
