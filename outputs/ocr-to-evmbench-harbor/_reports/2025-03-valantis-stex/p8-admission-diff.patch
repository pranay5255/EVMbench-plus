e it's not claimable yet are in the same queue at the same cumulative amount:\n<|det|>text [97, 857, 833, 936]<|/det|>if (address(this).balance <= amountToken1ClaimableLPWithdrawalCache) {\n    amountToken1ClaimableLPWithdrawal = address(this).balance;\n    return;\n}\n<|det|>page_number [911, 956, 935, 970]<|/det|>21\n", "page_image_sha256": "51627636f7c315eae84fa175ce4d940a73dbec5687d29bc8ae01def75ba77e9c", "page_number": 21, "pdf_id": "pdf_002911_39a2c2ee71c9", "raw_response_ref": "chunk_0028/other_audit_repo_pdfs/pdf_002911_39a2c2ee71c9_valantis-mar-25_Final/pages_0021_0024.raw.json", "source_abs_path": "/home/experiments_base/smart-contract-data/crawlers/output/repos/audit_repos/Smart-Contract-Review-Public-Reports/valantis-mar-25(Final).pdf", "source_bucket": "other_audit_repo_pdfs", "source_filename": "valantis-mar-25(Final).pdf", "source_page_count": 38, "source_pdf_sha256": "64bf545adb3699eed16cd21abb0d6db6a651ca273e2992a02122825ec61966a7", "source_rel_path": "Smart-Contract-Review-Public-Reports/valantis-mar-25(Final).pdf", "tables": [], "throughput": {"output_units": "tokens", "output_units_per_second": 411.324}, "timing_ms": {"decode": 1201, "sglang_total": 1419, "ttft": 217}, "usage": {"completion_token_source": "openai_usage", "completion_tokens": 494, "prompt_tokens": 278, "prompt_tokens_details": null, "reasoning_tokens": 0, "total_tokens": 772}, "warnings": []}, "raw_response_ref": "chunk_0028/other_audit_repo_pdfs/pdf_002911_39a2c2ee71c9_valantis-mar-25_Final/pages_0021_0024.raw.json", "schema_version": "evmbench_task_creation.ocr_page.v1", "source_bucket": "other_audit_repo_pdfs", "source_filename": "valantis-mar-25(Final).pdf", "source_page_count": 38, "source_pdf_sha256": "64bf545adb3699eed16cd21abb0d6db6a651ca273e2992a02122825ec61966a7", "source_rel_path": "Smart-Contract-Review-Public-Reports/valantis-mar-25(Final).pdf", "text_length": 1741}
